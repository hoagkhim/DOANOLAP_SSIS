                      length="20"
                      lineageId="Package\DIM_TIME\Derived Column.Outputs[Derived Column Output].Columns[Time_of_Day]"
                      name="Time_of_Day"
                      truncationRowDisposition="FailComponent">
                      <properties>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Expression"
                          name="Expression">(DT_WSTR,20)([DATEPART]("Hh",#{Package\DIM_TIME\Data Conversion.Outputs[Data Conversion Output].Columns[Time]}) &gt;= 5 &amp;&amp; [DATEPART]("Hh",#{Package\DIM_TIME\Data Conversion.Outputs[Data Conversion Output].Columns[Time]}) &lt; 12 ? "Morning" : [DATEPART]("Hh",#{Package\DIM_TIME\Data Conversion.Outputs[Data Conversion Output].Columns[Time]}) &gt;= 12 &amp;&amp; [DATEPART]("Hh",#{Package\DIM_TIME\Data Conversion.Outputs[Data Conversion Output].Columns[Time]}) &lt; 17 ? "Afternoon" : [DATEPART]("Hh",#{Package\DIM_TIME\Data Conversion.Outputs[Data Conversion Output].Columns[Time]}) &gt;= 17 &amp;&amp; [DATEPART]("Hh",#{Package\DIM_TIME\Data Conversion.Outputs[Data Conversion Output].Columns[Time]}) &lt; 21 ? "Evening" : "Night")</property>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Derived Column Friendly Expression"
                          expressionType="Notify"
                          name="FriendlyExpression">(DT_WSTR,20)(DATEPART("Hh",Time) &gt;= 5 &amp;&amp; DATEPART("Hh",Time) &lt; 12 ? "Morning" : DATEPART("Hh",Time) &gt;= 12 &amp;&amp; DATEPART("Hh",Time) &lt; 17 ? "Afternoon" : DATEPART("Hh",Time) &gt;= 17 &amp;&amp; DATEPART("Hh",Time) &lt; 21 ? "Evening" : "Night")</property>
                      </properties>
                    </outputColumn>
